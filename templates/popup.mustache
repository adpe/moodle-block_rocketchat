{{!
    @template block_rocketchat/popup

    This template renders a floating chatbot-like popup for a Rocket.Chat channel.

    Example context (json):
    {
        "name": "General",
        "url": "https://FQDN/channel/general?layout=embedded"
    }
}}
<div class="rocketchat-popup card" data-region="rocketchat-popup" role="dialog" aria-label="{{name}}">
    <div class="card-header">
        <div class="title">{{name}}</div>
        <div class="controls">
            <button class="btn btn-sm text-white" data-action="rocketchat-popup-minimize" title="{{#str}} minimize, block_rocketchat {{/str}}" aria-label="{{#str}} minimize, block_rocketchat {{/str}}" data-minimize-str="{{#str}} minimize, block_rocketchat {{/str}}" data-maximize-str="{{#str}} maximize, block_rocketchat {{/str}}">
                <span class="rocketchat-icon-minimize">{{#pix}} t/switch_minus, core {{/pix}}</span>
                <span class="rocketchat-icon-maximize">{{#pix}} t/switch_plus, core {{/pix}}</span>
            </button>
            <button class="btn-close btn-close-white" data-action="rocketchat-popup-close" title="{{#str}} closebuttontitle, core {{/str}}" aria-label="{{#str}} closebuttontitle, core {{/str}}"></button>
        </div>
    </div>
    <div class="card-body">
        <iframe src="{{url}}" title="{{name}}"></iframe>
    </div>
    <div class="rocketchat-popup-resize" aria-hidden="true"></div>
</div>
