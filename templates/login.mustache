{{!
    @template block_rocketchat/login

    This template renders the login form for the Rocket.Chat block.

    Example context (json):
    {
        "courseid": 2,
        "displaymode": "popup",
        "sesskey": "sesskey",
        "tmpusername": "username",
        "notifications": [
            {
                "type": "danger",
                "message": "Please try again and enter the correct credentials."
            }
        ]
    }
}}
<div id="block-rocketchat-{{uniqid}}" data-region="rocketchat" data-courseid="{{courseid}}" data-displaymode="{{displaymode}}">
    <div class="container-fluid p-0">
        {{#notifications}}
            <div class="alert alert-{{type}} alert-dismissible fade show" role="alert">
                {{message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{#str}} closebuttontitle {{/str}}"></button>
            </div>
        {{/notifications}}
        <form id="rocketchat_login" method="POST" action="#">
            <input type="hidden" name="rocketchat_login" value="1">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <p>{{# str}} intro, block_rocketchat {{/ str}}</p>

            <div class="mb-3">
                <label for="rocketchat_username" class="form-label">{{#str}} usernameemail {{/str}}</label>
                <input type="text" class="form-control" id="rocketchat_username" name="rocketchat_username" value="{{tmpusername}}">
            </div>

            <div class="mb-3">
                <label for="rocketchat_password" class="form-label">{{#str}} password {{/str}}</label>
                <input type="password" class="form-control" id="rocketchat_password" name="rocketchat_password" value="">
            </div>

            <button type="submit" class="btn btn-primary w-100">{{#str}} login {{/str}}</button>
        </form>
    </div>
</div>